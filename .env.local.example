# Frontend Environment Variables
# Copy this to .env.local and update with your values

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your_supabase_anon_key_here

# Railway API Configuration
VITE_API_URL=https://your-app-name.railway.app

# Mapbox Configuration (optional)
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# AWS S3 Configuration (if using S3 instead of Supabase Storage)
VITE_AWS_REGION=us-east-1
VITE_AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
VITE_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
VITE_S3_BUCKET_NAME=biochar-photos

# Development Settings
VITE_DEV_MODE=true
VITE_ENABLE_MOCK_DATA=false
